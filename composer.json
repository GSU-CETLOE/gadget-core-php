{
  "name": "gsu-cetloe/gadget-core-php",
  "description": "Gadget is a PHP micro framework of small, dependency-free helpers for casting, JSON, Base32, files, DOM parsing, timing, and one-time passwords",
  "type": "library",
  "keywords": [
    "framework",
    "micro"
  ],
  "homepage": "https://github.com/GSU-CETLOE/gadget-core-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeb Barger",
      "role": "Application Developer"
    }
  ],
  "require": {
    "php": "8.1.*",
    "ext-json": "*",
    "ext-dom": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/extension-installer": "^1.4",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Gadget\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gadget\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "apcu-autoloader": true
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
    "test": "vendor/bin/phpunit",
    "check": [
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  }
}
